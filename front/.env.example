# このファイルをコピーして front/.env を作成してください:
#   cp .env.example .env
# ここに列挙した変数がアプリで実際に使用される環境変数の正（Single Source）です。
#
# 既定値は「ローカル Supabase（pnpm run dev:db:up）」向けです。本番の接続情報はここに書かない。
# （.claude/rules/production-data.md「本番の接続情報をローカルの既定環境変数に常駐させない」）
# `next dev` は DATABASE_URL がローカル以外を指していると起動を中断します（src/lib/localDatabaseUrl.ts）。

# --- Supabase（必須）---
# ローカル: `supabase status -o env` の API_URL / ANON_KEY（CLI が払い出す固定のデモ値）
# 本番: Vercel の環境変数で設定（Settings > API の値）
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Database（必須）---
# ローカル Supabase の DB。未設定時は API が 503 を返すフォールバック動作
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres

# --- 認証（必須）---
# 管理者として許可するメールアドレス（このアドレスのみ管理操作が可能）
ADMIN_EMAIL=

# --- App ---
# サイト URL（OAuth リダイレクト等に使用）。本番/プレビューは Vercel 側で設定
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- 認証バイパス（任意・開発時のみ）---
# 管理者認証をバイパスするサーバー専用フラグ。NODE_ENV=production では無効。
# - E2E: 手動設定不要（playwright.config.ts が `E2E_BYPASS=1 pnpm dev` で自動付与）
# - ローカル開発: ローカル Supabase には Google OAuth を設定していないため、管理画面の書き込みを
#   試す場合はコメントを外し、管理ログイン画面の「テストログイン」ボタンでログインする
# E2E_BYPASS=1

# 注: Google OAuth のクライアント ID/Secret はアプリの環境変数ではなく
#     Supabase ダッシュボード（Authentication > Providers > Google）で設定します。
#
# 注: 本番の接続情報（手動マイグレーション等で必要な場合のみ）は、Next.js / Prisma が
#     自動で読み込まない front/.env.prod に `PROD_` 接頭辞の別変数名で置く（例: PROD_DATABASE_URL）。
#     .env.production / .env.production.local は `next build` / `next start` が自動で読むため使わない。
