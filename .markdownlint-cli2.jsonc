// markdownlint 設定。
// 方針: 見た目・スタイルの好みは検査せず、「壊れているもの」だけを検出する。
// Formatter（Prettier）と競合させないため、行長・空行・強調記号の種類等は無効化する
// （.claude/rules/static-analysis.md「見た目に関する Linter ルールを有効にしない」）。
{
  "config": {
    "default": true,

    // --- 見た目・スタイル: Prettier の領分なので無効 ---
    "MD004": false, // 箇条書き記号の統一
    "MD007": false, // ネストのインデント幅
    "MD013": false, // 行の長さ上限（日本語の散文で無意味に落ちる）
    "MD012": false, // 連続空行
    "MD022": false, // 見出し前後の空行
    "MD024": false, // 同名見出しの重複（章ごとに「概要」等が並ぶため許容）
    "MD029": false, // 順序付きリストの採番方式
    "MD030": false, // リスト記号の後のスペース数
    "MD032": false, // リスト前後の空行
    "MD033": false, // インライン HTML（意図的に使う箇所がある）
    "MD034": false, // 裸の URL
    "MD036": false, // 強調を見出し代わりに使う
    "MD041": false, // 先頭行が h1 であること（frontmatter を持つファイルがある）
    "MD046": false, // コードブロックの記法統一
    "MD049": false, // 強調記号の種類
    "MD050": false, // 太字記号の種類
    "MD060": false, // 表のパイプ位置・桁揃え

    // --- 壊れているものの検出: 有効に保つ ---
    // MD011 リンク記法の逆転、MD042 空リンク、MD045 画像の alt 欠落、
    // MD047 ファイル末尾の改行 などはデフォルト有効のまま
    "MD040": true // コードブロックの言語指定（シンタックスハイライトが効かなくなるため）
  },
  "globs": ["**/*.md"],
  "ignores": ["**/node_modules/**", "front/src/generated/**", "base/**"]
}
